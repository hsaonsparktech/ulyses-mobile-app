{
  "name": "libros-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@hookform/resolvers": "^5.9.2",
    "@tanstack/react-query": "^5.107.1",
    "axios": "^1.21.1",
    "expo": "~57.0.33",
    "expo-constants": "~57.0.24",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.14",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.31",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-web-browser": "~57.0.3",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.92.0",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.17",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "lint-staged": "^16.4.0",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "3.4.17",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "server:typecheck": "tsc -p server/tsconfig.json --noEmit",
    "server:build": "tsc -p server/tsconfig.json",
    "server:migrate": "npx tsx server/src/db/migrate.ts",
    "server:seed": "npx tsx server/src/db/seed.ts",
    "server:start": "npx tsx server/src/server.ts",
    "server:test": "npx tsx --test server/tests/*.test.ts",
    "check": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit && biome check . && jest --runInBand && npx tsx --test server/tests/*.test.ts",
    "doctor": "npx expo install --check && npx expo-doctor@latest",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx,json,jsonc}": "biome check --write --no-errors-on-unmatched"
  }
}
